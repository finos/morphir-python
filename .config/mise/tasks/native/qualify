#!/usr/bin/env bash
#MISE description="Qualify built native, core and tools distributions without Rust on PATH"
set -euo pipefail

native="${NATIVE_DIST:-$PWD/dist/native}"
receipts="${QUALIFICATION_DIR:-$PWD/.dev/qualification}"
mkdir -p "$receipts"
shopt -s nullglob
if [[ ${RELEASE_TAG:-} == python-v* ]]; then
  # A CLI release ships with the published native compiler, so qualify those bytes,
  # and refuse if the compiler sources changed after that native release.
  pin="$(python3 -c 'import sys; sys.path.insert(0, "scripts"); import qualify_native as q; print(q.tools_pin())')"
  git fetch --quiet --depth=1 origin "refs/tags/native-v$pin:refs/tags/native-v$pin"
  if ! git diff --quiet "native-v$pin" HEAD -- rust packages/morphir-python-native; then
    echo "the native compiler changed after native-v$pin; release a new native version first" >&2
    exit 1
  fi
  native="$receipts/published-native"
  rm -rf "$native"
  uvx pip download --quiet --no-deps --only-binary=:all: --implementation cp \
    --python-version 3.14 --abi abi3 --platform manylinux_2_28_x86_64 \
    --dest "$native" "morphir-python-native==$pin"
  export SKIP_SDIST_BUILD=1
fi
wheels=("$native"/morphir_python_native-*.whl)
if [[ ${#wheels[@]} -ne 1 ]]; then
  echo "expected exactly one native wheel in $native" >&2
  exit 1
fi
python3 scripts/qualify_native.py wheel "${wheels[0]}" >"$receipts/native-wheel.json"
sdists=("$native"/morphir_python_native-*.tar.gz)
if [[ ${#sdists[@]} -eq 1 && "${SKIP_SDIST_BUILD:-0}" != 1 ]]; then
  rm -rf "$receipts/from-sdist"
  python3 scripts/qualify_native.py sdist "${sdists[0]}" --out "$receipts/from-sdist" \
    >"$receipts/native-sdist.json"
  # The wheel built from the archive alone must work when installed, too.
  python3 scripts/qualify_native.py install \
    packages/morphir/dist/morphir-*.whl "$receipts"/from-sdist/morphir_python_native-*.whl \
    packages/morphir-tools/dist/morphir_python-*.whl >"$receipts/sdist-install.json"
fi
python3 scripts/qualify_native.py install \
  packages/morphir/dist/morphir-*.whl "${wheels[0]}" packages/morphir-tools/dist/morphir_python-*.whl \
  >"$receipts/clean-install.json"
cat "$receipts"/*.json
