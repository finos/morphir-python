#!/usr/bin/env bash
#MISE description="Build and run an independent Cargo consumer of this commit's compiler crate"
set -euo pipefail

repository="$(git rev-parse --show-toplevel)"
revision="$(git rev-parse HEAD)"
consumer="$(mktemp -d)/consumer"
trap 'rm -rf "$(dirname "$consumer")"' EXIT

cargo new --quiet "$consumer"
cat >>"$consumer/Cargo.toml" <<TOML
morphir-python-binding = { git = "file://$repository", rev = "$revision" }
morphir-extension-sdk = "=0.3.0"
serde_json = "1"
TOML
# The README example is the consumer's main program.
python3 - "$repository/rust/crates/morphir-python-binding/README.md" "$consumer/src/main.rs" <<'PY'
import sys
text = open(sys.argv[1]).read()
start = text.index("## Use the crate from another Rust project")
body = text.index("```rust\n", start) + len("```rust\n")
open(sys.argv[2], "w").write(text[body:text.index("```", body)])
PY
output="$(cd "$consumer" && cargo run --quiet)"
grep -q "def choose(" <<<"$output"
if grep -q 'name = "pyo3' "$consumer/Cargo.lock"; then
  echo "the consumer resolved PyO3" >&2
  exit 1
fi
echo "independent consumer at $revision compiled and generated Python"
