#!/usr/bin/env bash
#MISE description="Qualify separate library and CLI distributions for release"
set -euo pipefail

release_dir="$(pwd)/.dev/release-check"
mkdir -p "$release_dir"
uv lock --check
python scripts/check_distributions.py
uvx --from twine==7.0.0 twine check --strict \
  packages/morphir/dist/* packages/morphir-tools/dist/*
uv export --frozen --all-packages --no-default-groups --no-emit-workspace \
  --no-hashes --output-file "$release_dir/constraints.txt"

packages=(morphir morphir-python)
if [[ ${RELEASE_TAG:-} == morphir-v* ]]; then
  packages=(morphir)
elif [[ ${RELEASE_TAG:-} == python-v* ]]; then
  packages=(morphir-python)
fi

for package in "${packages[@]}"; do
  uv venv --clear --python 3.14 "$release_dir/$package-venv"
  release_python="$release_dir/$package-venv/bin/python"
  if [[ "$package" == morphir ]]; then
    uv pip install --python "$release_python" packages/morphir/dist/*.whl
    "$release_python" -I - <<'PY_CORE'
from importlib.metadata import distribution
from importlib.util import find_spec

import morphir
from morphir.ir import format_version
from morphir.sdk import basics

core = distribution("morphir")
assert morphir.__version__ == core.version
assert not core.requires
assert not core.entry_points
assert basics.round(2.5) == 3
assert format_version.V3.major == 3
assert find_spec("morphir_tools") is None
assert find_spec("typer") is None
PY_CORE
  else
    uv pip install --python "$release_python" --constraint "$release_dir/constraints.txt" \
      packages/morphir/dist/*.whl packages/morphir-tools/dist/*.whl
    "$release_python" -I - <<'PY_CLI'
from importlib.metadata import distribution, version

import morphir
import morphir_tools

assert morphir.__version__ == version("morphir")
assert morphir_tools.__version__ == version("morphir-python")
core_files = set(distribution("morphir").files or [])
cli_files = set(distribution("morphir-python").files or [])
assert not core_files.intersection(cli_files)
PY_CLI
    "$release_dir/$package-venv/bin/morphir-python" ir inspect \
      tests/fixtures/ir/v3/elm-simpleValueTree.json
  fi
  uv pip check --python "$release_python"
  uv pip freeze --python "$release_python" --exclude morphir --exclude morphir-python \
    > "$release_dir/$package-requirements.txt"
  if [[ -s "$release_dir/$package-requirements.txt" ]]; then
    uvx --from pip-audit==2.10.1 pip-audit --strict --no-deps --disable-pip \
      --requirement "$release_dir/$package-requirements.txt" \
      --format json --output "$release_dir/$package-vulnerabilities.json"
  else
    echo '{"dependencies": [], "fixes": []}' > "$release_dir/$package-vulnerabilities.json"
    echo "$package has no third-party runtime dependencies to audit"
  fi
  uvx --from pip-licenses==5.5.0 pip-licenses --python "$release_python" \
    --from=mixed \
    --allow-only='Apache-2.0;Apache Software License;MIT;MIT License;BSD-2-Clause;BSD-3-Clause;BSD License;ISC;ISC License;ISC License (ISCL)' \
    --format=json --output-file "$release_dir/$package-licenses.json"
done

# Exercise the supported migration from the old distribution, which owned both
# namespaces. Uninstall old owners before installing the split distributions.
if [[ ${RELEASE_TAG:-} == morphir-v* ]]; then
  exit 0
fi
uv venv --clear --python 3.14 "$release_dir/migration-venv"
migration_python="$release_dir/migration-venv/bin/python"
uv pip install --python "$migration_python" --constraint "$release_dir/constraints.txt" \
  'morphir-python==0.0.1'
uv pip uninstall --python "$migration_python" morphir-python morphir
uv pip install --python "$migration_python" --constraint "$release_dir/constraints.txt" \
  packages/morphir/dist/*.whl packages/morphir-tools/dist/*.whl
"$migration_python" -I - <<'PY_MIGRATION'
from importlib.metadata import version

import morphir
import morphir_tools
from morphir.sdk import basics

assert morphir.__version__ == version("morphir")
assert morphir_tools.__version__ == version("morphir-python")
assert basics.round(2.5) == 3
PY_MIGRATION
"$release_dir/migration-venv/bin/morphir-python" --help
uv pip check --python "$migration_python"
