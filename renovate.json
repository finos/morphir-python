{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "ruff_python_parser",
        "ruff_python_ast",
        "ruff_python_codegen",
        "ruff_text_size"
      ],
      "groupName": "Ruff components"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "tools/extension-qualification/Cargo.toml"
      ],
      "matchPackageNames": [
        "morphir-extension-sdk",
        "morphir-host",
        "morphir-host-native"
      ],
      "groupName": "qualification host source"
    }
  ]
}
