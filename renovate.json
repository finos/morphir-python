{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Keep Rust crate updates together across both Cargo workspaces, including Ruff and the qualification host.",
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies",
      "groupSingleUpdates": true,
      "separateMajorMinor": false
    },
    {
      "description": "Keep the historical qualification host aligned with its source receipt. Published host crates are not available yet; update the host and receipt together by hand.",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "tools/extension-qualification/Cargo.toml"
      ],
      "matchDepNames": [
        "morphir-extension-sdk",
        "morphir-host",
        "morphir-host-native"
      ],
      "enabled": false
    },
    {
      "description": "Keep GitHub Actions updates together.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSingleUpdates": true,
      "separateMajorMinor": false
    },
    {
      "description": "Keep Rust compiler and build-tool versions in their own group across all their declarations.",
      "groupName": "Rust toolchain",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "matchDepNames": [
        "rust",
        "wasm-tools",
        "maturin"
      ]
    }
  ]
}
